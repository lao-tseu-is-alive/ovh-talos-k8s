# Valeurs privees de fwinit_ovh-fw-k3s.sh. Copier en fwinit_ovh-fw-k3s.env
# a cote du script sur le bastion (chmod 0600). Ne jamais versionner le .env.

# Passerelle par defaut du site de Lausanne (SSH + DNAT vers les noeuds)
TRUSTEDIP01="<ip_publique_site_lausanne>"
# Ancien serveur, transferts
TRUSTEDIP02="<ip_publique_old_map>"
# Serveur personnel
TRUSTEDIP03="<ip_publique_serveur_perso>"
# VPS bastion OVH (SSH, Prometheus)
BASTION01="<ip_publique_vps_bastion>"
# Passerelle Camptocamp (acces temporaire a ovh-cartotest-2026)
CAMPTOCAMP="<ip_publique_camptocamp>"
# IP publique du bastion ovh-fw-k3s sur ens18
EXTIP="<ip_publique_bastion>"
